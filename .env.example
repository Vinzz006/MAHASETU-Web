# ==============================================================================
# MahaSetu Root Environment Configuration
# Problem Statement 26129 — Interoperability & Service Passport Platform
# ==============================================================================

DEMO_MODE=true

# Database configuration (PostgreSQL or SQLite)
DATABASE_URL=sqlite:///./mahasetu.db
# For PostgreSQL:
# DATABASE_URL=postgresql://mahasetu_user:mahasetu_password@localhost:5432/mahasetu_db

# Security & JWT (Generate with: openssl rand -hex 32 or python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=changeme-generate-a-long-random-value-never-use-default
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server ports
BACKEND_PORT=8000
FRONTEND_PORT=5173

# ------------------------------------------------------------------------------
# 1. Firebase Admin & Client
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_STORAGE_BUCKET=

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ------------------------------------------------------------------------------
# 2. Twilio SMS
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ------------------------------------------------------------------------------
# 3. Google Gemini AI Assistant (google-genai SDK / gemini-2.5-flash)
# Obtain key from https://aistudio.google.com/apikey
# Required in production (DEMO_MODE=false)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
