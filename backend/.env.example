# ==============================================================================
# MahaSetu Backend Environment Configuration
# Problem Statement 26129 — Interoperability & Service Passport Platform
# ==============================================================================

# Application Mode
# Set to true for local testing, demo personas, and unit tests without external API keys.
# When set to false, missing production credentials will fail loudly at startup.
DEMO_MODE=true

# Database Configuration (Defaults to local SQLite for zero-config dev)
DATABASE_URL=sqlite:///./mahasetu.db
# PostgreSQL Example:
# DATABASE_URL=postgresql://mahasetu_user:mahasetu_password@localhost:5432/mahasetu_db

# Security & JWT Token Verification (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=changeme-generate-a-long-random-value-never-use-default
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 1. Firebase Admin SDK (Phase 1 Auth & Phase 2 Storage)
# Required for verifying client ID tokens and streaming private resident documents
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_STORAGE_BUCKET=

# ------------------------------------------------------------------------------
# 2. Twilio SMS Notifications (Phase 5)
# Required for SMS dispatch to citizens across the 7 application lifecycle transitions
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ------------------------------------------------------------------------------
# 3. Google Gemini AI Assistant (Phase 6 / google-genai SDK)
# Required for grounding the citizen assistant via Gemini 2.5 Flash.
# Obtain API key from Google AI Studio: https://aistudio.google.com/apikey
# Or configure a Google Cloud Vertex AI service account.
# In live production mode (DEMO_MODE=false), the assistant refuses to start without this key.
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

