# ==============================================================================
# MahaSetu Frontend Environment Configuration
# ==============================================================================

# Application Mode
# Set to true to enable demo personas and quick-switching in the UI
VITE_DEMO_MODE=true

# ------------------------------------------------------------------------------
# Firebase Web Client Configuration (Phase 1 Auth)
# Used by the frontend client SDK to authenticate citizens
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
